# ─────────────────────────────────────────────────────────────────────────────
# MyPaddock — modèle d'environnement.  Copier en `.env.local`, ne jamais commiter.
#
# RÈGLE DURE (AD-15) : tout ce qui est préfixé VITE_ PART DANS LE PAQUET CLIENT
# et est donc PUBLIC. Aucune clé de service, aucune clé de fournisseur d'IA
# ne porte ce préfixe. Si tu hésites, la réponse est non.
# ─────────────────────────────────────────────────────────────────────────────

# ── CLIENT — public, embarqué dans le bundle ─────────────────────────────────

# Le nom du produit. UNE SEULE CONSTANTE (critère du récit 0.3) : écrans,
# manifeste, <title>, icônes, cartes de partage. MyPaddock est un NOM DE CODE —
# QO-1 est ouverte, rien de public sous ce nom. Renommer = changer cette ligne.
VITE_APP_NAME="MyPaddock"

VITE_SUPABASE_URL=""
# Clé PUBLIABLE uniquement (sb_publishable_…). Jamais la service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Instance PowerSync. Palier gratuit : 2 Go synchronisés/mois, 500 Mo hébergés,
# 50 connexions simultanées — ET DÉSACTIVATION APRÈS 1 SEMAINE D'INACTIVITÉ,
# ce qui est un problème structurel pour un produit ouvert 11 fois par an.
VITE_POWERSYNC_URL=""

# ── SERVEUR — Railway, service de récolte. JAMAIS dans le paquet client ──────

SUPABASE_URL=""
# AD-12 : le rôle de récolte n'a AUCUN accès en écriture aux tables du pilote.
# Utiliser un rôle Postgres dédié, PAS la service_role.
SUPABASE_HARVEST_ROLE_URL=""

# Extraction assistée par IA du barème constructeur et des calendriers.
# Rappel de responsabilité : une extraction par IA n'est pas une transcription,
# c'est une reconstruction. Tout barème récolté porte sa source, sa date et la
# mention qu'il a été extrait automatiquement (FR-61, frontière recommandation).
ANTHROPIC_API_KEY=""

# ── À NE PAS RÉUTILISER ──────────────────────────────────────────────────────
# Le projet Railway `mypaddock_api` (déc. 2025) est un AUTRE produit : cote et
# valorisation moto, crawlers de concessionnaires US, proxies rotatifs.
# Condition 5 de l'audit de viabilité : « secrets historiques renouvelés et
# aucun ancien extracteur réactivé ». Ne rien recycler de ses variables.
