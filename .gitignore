# ── Secrets ───────────────────────────────────────────────────────────────
# `.env.*` attrape .env.production, .env.development et tout ce qu'on n'a pas
# prévu ; l'exception explicite garde le modèle à valeurs vides.
.env
.env.*
!.env.example
*.pem
.npmrc

# La CLI Supabase écrit ici `pooler-url`, qui embarque la chaîne de connexion
# Postgres AVEC le mot de passe. Ce répertoire a été suivi par erreur au commit
# 949985b — créé par un simple `supabase projects list` — et un `git add -A`
# réflexe après un `supabase link` aurait publié le mot de passe de la base.
supabase/.temp/

# ── Construits ────────────────────────────────────────────────────────────
node_modules/
dist/
.DS_Store
.vercel
.railway

# graft/.cache/ contient le texte brut des prompts (session cache) et des
# artefacts régénérables ; graft/.graph/ se reconstruit avec `graft build`.
graft/.cache/
graft/.graph/

# ── Trois codebases MyPaddock anterieures, clonees comme depots imbriques ──
# Reference uniquement. Condition 5 de l'audit de viabilite : secrets
# historiques renouveles, aucun ancien extracteur reactive.
context/

# Banc de rendu — photos personnelles, jamais versionnées
banc-rendu/photos/*
!banc-rendu/photos/.gitkeep
banc-rendu/sorties/

# La photo d'essai de 48,8 Mpx se FABRIQUE (`node banc-rendu/photo-essai.mjs`) :
# 2,3 Mo qui se regénèrent en trois secondes n'ont rien à faire dans l'histoire
# du dépôt.
banc-rendu/.fixtures/
